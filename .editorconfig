# ==============================================================================
# 🛠️ EDITORCONFIG: LLMOps & Agentic AI Enterprise Standard
# ==============================================================================
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 119

[{Makefile,makefile}]
indent_style = tab
indent_size = 4
trim_trailing_whitespace = false
max_line_length = off

[*.sh]
indent_style = space
indent_size = 2

[{Dockerfile,*.dockerignore}]
indent_style = space
indent_size = 4

[*.{csv,tsv}]
trim_trailing_whitespace = false
insert_final_newline = false

[*.{json,ipynb,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.{html,css,js}]
indent_style = space
indent_size = 2

[*.{md,txt}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

[{.env,*.env,.env.*,.gitignore}]
indent_style = space
indent_size = 2
