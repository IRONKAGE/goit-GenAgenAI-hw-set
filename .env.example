# ==============================================================================
# 🔐 ШАБЛОН НАЛАШТУВАНЬ СЕРЕДОВИЩА: goit-GenAgenAI-hw-set (Листопад 2026)
# ==============================================================================
# ІНСТРУКЦІЯ:
# 1. Зробіть копію цього файлу та назвіть її `.env`
# 2. Заповніть наявні ключі (або залиште порожніми — тоді 3-Tier Smart Router
#    автоматично використає локальний сервер llama.cpp або детермінований кеш)
# ==============================================================================

# ------------------------------------------------------------------------------
# 🥇 TIER 1: ХМАРНІ LLM ПРОВАЙДЕРИ (Cloud Free / Low-Cost API)
# ------------------------------------------------------------------------------
# Варіант А: Google AI Studio (Безкоштовний tier для Gemini 2.5 Flash / 3.1 Pro)
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-flash-lite-latest

# Варіант Б: OpenRouter (Рекомендовано в оновленнях ДЗ 2, 3, 4: openai/gpt-oss-120b)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=openai/gpt-oss-120b

# Варіант В: Прямий OpenAI API (Актуальні моделі листопада 2026: gpt-5.6-luna / gpt-5.6-terra)
OPENAI_API_KEY=""
OPENAI_MODEL=gpt-5.6-luna
OPENAI_JUDGE_MODEL=gpt-5.6-terra

# ------------------------------------------------------------------------------
# 🥈 TIER 2: АВТОНОМНИЙ ЛОКАЛЬНИЙ ІНФЕРЕНС (llama.cpp / Ollama / vLLM)
# ------------------------------------------------------------------------------
# Приклад для llama-server: http://localhost:8080/v1 або Ollama: http://localhost:11434/v1
LOCAL_LLM_URL=""
LOCAL_LLM_MODEL=qwen3.5-14b-instruct

# ------------------------------------------------------------------------------
# 🌐 ВЕБПОШУК ДЛЯ ФІНАЛЬНОГО ПРОЕКТУ ТА АГЕНТІВ (Тема 6 & Фінальний Проект)
# ------------------------------------------------------------------------------
# Tavily Search API (1000 безкоштовних кредитів на місяць без прив'язки картки)
TAVILY_API_KEY=""
# Google Serper API (serper.dev — опційно для інструментів пошуку Google)
SERPER_API_KEY=""

# ------------------------------------------------------------------------------
# 📈 LANGSMITH & MLFLOW TRACING (Телеметрія ланцюгів і графів)
# ------------------------------------------------------------------------------
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="neoversity-genagenai-2026"
# Для акаунтів у ЄС/Швейцарії: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

MLFLOW_TRACKING_URI="sqlite:///mlruns/mlruns.db"
MLFLOW_EXPERIMENT_NAME="goit_genagenai_portfolio"

# ------------------------------------------------------------------------------
# ⚙️ CORE INFRASTRUCTURE (Глобальні налаштування)
# ------------------------------------------------------------------------------
ML_BACKEND=
GLOBAL_SEED=42
DATA_DIR="./data"
MODELS_DIR="./models"
SUBMISSIONS_DIR="./submissions"
USER_AGENT="MyLangChainAgent/1.0 (contact: oleh.hatsenko@neoversity.edu)"
PYTORCH_ENABLE_MPS_FALLBACK=1
